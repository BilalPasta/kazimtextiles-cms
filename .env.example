# Postgres connection (local: `pnpm db:up` starts one on port 5440)
DATABASE_URI=postgres://kazim:kazim@localhost:5440/kazim_textiles
# Long random string — used to sign admin sessions
PAYLOAD_SECRET=change-me
# Public site URL, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Set to "true" only on the live production domain. Anything else = noindex + robots disallow.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Resend: emails each quote request to Site Settings → Contact → "Send quote requests to"
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. quotes@yourdomain.com
RESEND_FROM_ADDRESS=
RESEND_FROM_NAME=Kazim Textiles
